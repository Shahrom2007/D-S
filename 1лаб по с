#include <stdio.h>

#define GETBIT(j) (((b[(j)/8] >> (7 - ((j) % 8))) & 1))
#define CLRBIT(j) (b[(j)/8] &= ~(1 << (7 - ((j) % 8))))

int main(int argc, char **argv)
{
    unsigned char b[10000000] = {0};
    unsigned long long *L = (unsigned long long *)b;
    
    // Заполняем массив битовыми паттернами
    for (int i = 0; i < (10000000 / 8); i++) {
        *L++ = 0xFFFFFFFFFFFFFFFFULL;  // Все биты установлены в 1
    }
    
    // Сбрасываем первые два бита в 0
    CLRBIT(0);
    CLRBIT(1);
    
    // Выводим первые 128 бит
    for (int i = 0; i < 128; i++) {
        printf("%d", GETBIT(i));
        if ((i + 1) % 64 == 0) putchar('\n');  // Перенос строки каждые 64 бита
    }
    
    return 0;
}
