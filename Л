def analyze_romance(pairs):
    # 1. Проверка на "нарциссов" (x, x)
    narcissists = [x for x, y in pairs if x == y]
    if len(narcissists) == 1:
        print("«есть нарцисс»")
    elif len(narcissists) > 1:
        print("«есть нарциссы»")

    # Счастливые (взаимные) люди
    mutual_people = set()
    for x, y in pairs:
        if x != y and (y, x) in pairs:
            mutual_people.add(x)
            mutual_people.add(y)

    # 3. Наличие счастливых пар (2 человека на пару)
    num_happy = len(mutual_people)
    if num_happy == 2:
        print("«есть счастливая пара»")
    elif num_happy == 4:
        print("«есть две счастливые пары»")
    elif num_happy == 6:
        print("«идиллия, все счастливы»")

    # 2. Безответная любовь
    has_one_sided = False
    for x, y in pairs:
        if x != y and (y, x) not in pairs:
            has_one_sided = True
            break
    if has_one_sided:
        print("«безответная любовь»")

    # 4. Любовный квадрат
    has_square = False
    for x, y in pairs:
        for y2, z in pairs:
            if y == y2 and z not in (x, y):
                for z2, k in pairs:
                    if z == z2 and k not in (x, y, z):
                        for k2, start in pairs:
                            if k == k2 and start == x:
                                has_square = True
    if has_square:
        print("«есть любовный квадрат»")

def main():
    all_pairs = []
    print("--- Пошаговый ввод имен ---")
    
    while True:
        print(f"\nТекущие отношения: {all_pairs}")
        who = input("Кто любит? (введите 1-ю букву или имя): ").strip().upper()
        whom = input("Кого любит? (введите 1-ю букву или имя): ").strip().upper()
        
        if who and whom:
            # Берем только первую букву, как вы просили
            all_pairs.append((who[0], whom[0]))
        
        cont = input("Добавить еще пару? (д/н): ").lower()
        if cont != 'д':
            break

    print("\n" + "="*30)
    print("РЕЗУЛЬТАТ АНАЛИЗА:")
    analyze_romance(all_pairs)
    print("="*30)

if __name__ == "__main__":
    main()
