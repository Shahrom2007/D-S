# ========== ДОБАВЛЕННАЯ ЧАСТЬ: СТРЕЛЬБА ТАНКОВ ==========

def check_shots(tank_mask_self, tank_mask_enemy, self_start_x, self_start_y, self_end_x, self_end_y):
    """Проверяет, может ли танк попасть в противника выстрелами во все стороны"""
    
    # Все 8 направлений стрельбы
    directions = [(-1, 0), (1, 0), (0, -1), (0, 1),  # вверх, вниз, влево, вправо
                  (-1, 1), (-1, -1), (1, 1), (1, -1)]  # диагонали
    
    # Перебираем все клетки танка (откуда может стрелять)
    for i in range(self_start_x, self_end_x):
        for j in range(self_start_y, self_end_y):
            for dr, dc in directions:
                r, c = i, j
                # Движемся в направлении выстрела
                while True:
                    r += dr
                    c += dc
                    
                    # Проверка выхода за границы поля
                    if r < 0 or r >= 10 or c < 0 or c >= 10:
                        break
                    
                    # Попадание в танк противника
                    if tank_mask_enemy[r, c]:
                        return True
                    
                    # Попадание в свой танк (не может стрелять сквозь себя)
                    if self_start_x <= r < self_end_x and self_start_y <= c < self_end_y:
                        break
    
    return False

# Проверяем, попадает ли Tank 1 в Tank 2
