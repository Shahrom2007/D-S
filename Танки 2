def get_fire_mask(x_start, x_end, y_start, y_end):
    fire_mask = np.zeros((10, 10), dtype=bool)
    
    
    barrel_x = max(x_start, x_end - 2)
    barrel_y = max(y_start, y_end - 2)
   
    for i in range(1, 5):
        if barrel_x - i >= 0:
            fire_mask[barrel_x - i, barrel_y] = True  # Вверх
        if barrel_x + i < 10:
            fire_mask[barrel_x + i, barrel_y] = True  # Вниз
        if barrel_y - i >= 0:
            fire_mask[barrel_x, barrel_y - i] = True  # Влево
        if barrel_y + i < 10:
            fire_mask[barrel_x, barrel_y + i] = True  # Вправо
    
    return fire_mask


fire1_mask = get_fire_mask(x1_start, x1_end, y1_start, y1_end)
fire2_mask = get_fire_mask(x2_start, x2_end, y2_start, y2_end)


tank1_under_fire = np.any(fire2_mask & tank1_mask)
tank2_under_fire = np.any(fire1_mask & tank2_mask)

print("\n--- Статус обстрела ---")


if tank1_under_fire and tank2_under_fire:
    print("оба под огнем")
